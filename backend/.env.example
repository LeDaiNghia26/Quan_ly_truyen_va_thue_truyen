# Copy file này thành backend/.env rồi sửa giá trị theo máy của bạn.
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=quanlytruyen

# Đổi thành chuỗi bí mật khác khi triển khai thật
